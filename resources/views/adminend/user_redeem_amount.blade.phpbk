<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    const userData = @json($userData);
</script>
<script>
    var table;

    $(document).ready(function() {
        var baseUrl = "{{ url('/') }}";

        const statusMap = {
            0: { label: 'Cancelled',  class: 'danger' },
            1: { label: 'Success',    class: 'success' },
            2: { label: 'Pending',    class: 'warning' },
            3: { label: 'Processing', class: 'info' }
        };

        let columns = [

            {
                data: 'name',
                defaultContent: '-'
            },

            {
                data: 'email',
                defaultContent: '-'
            },

            {
                data: 'phone',
                defaultContent: '-'
            },

            {
                data: 'amount',
                defaultContent: '0.00',
                render: function(data) {
                    return '₹' + parseFloat(data ?? 0).toFixed(2);
                }
            },

            {
                data: 'tds',
                defaultContent: '0.00',
                render: function(data) {
                    return '₹' + parseFloat(data ?? 0).toFixed(2);
                }
            },

            {
                data: 'net_amount',
                defaultContent: '0.00',
                render: function(data) {
                    return '<strong>₹' + parseFloat(data ?? 0).toFixed(2) + '</strong>';
                }
            },

            {
                data: 'referral_items_count',
                defaultContent: '0'
            },

            {
                data: 'referral_redeemed_total',
                defaultContent: '0.00',
                render: function(data) {
                    return '₹' + parseFloat(data ?? 0).toFixed(2);
                }
            },

            {
                data: 'referral_invoices',
                defaultContent: '-',
                render: function(data) {
                    if (!data) return '-';
                    return `<div class="referral-invoices" title="${data}">${data}</div>`;
                }
            },

            {
                data: null,
                orderable: false,
                render: function(data, type, row) {
                    var s = statusMap[row.status] || { label: 'Unknown', class: 'secondary' };
                    return `<span class="badge-${s.class}">${s.label}</span>`;
                }
            },

            {
                data: 'created_on',
                defaultContent: '-'
            }

        ];


        table = $('#redeemList').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: "{{ route('get.user.redeem.amount.list') }}", // Route to fetch data
                type: "GET",
                data: function(d) {
                    d.searchQuery = $('#searchQuery').val(); // Pass search value manually
                }
            },
            columns: columns
        });

        // Handle Search Button Click
        $('#searchBtn').click(function() {
            var searchQuery = $('#searchQuery').val();
            if (searchQuery.length >= 3) {
                table.ajax.reload(); // Reload DataTable with new search filter
            } else {
                alert('Please enter at least 3 characters to search.');
            }
        });

        $("#searchQuery").on("keypress", function(e) {
            if (e.which === 13) { // Enter key
                e.preventDefault();
                $("#searchBtn").click(); // just trigger the click event
            }
        });
    });
</script>

@endsection