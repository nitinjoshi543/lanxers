<script>
const form = document.getElementById('signupForm');
const officialName = document.getElementById('officialName');
const repName = document.getElementById('repName');
const emailField = document.getElementById('emailField');
const email = document.getElementById('email');
const password = document.getElementById('password');
const country = document.getElementById('country');
const agree = document.getElementById('agree');
const submitBtn = document.getElementById('submitBtn');
const togglePass = document.getElementById('togglePass');

const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

function validateEmail(showError){
  const val = email.value.trim();
  const isValid = val === '' ? false : emailRegex.test(val);
  if(val !== '' && !isValid && showError){
    emailField.classList.add('error');
  } else {
    emailField.classList.remove('error');
  }
  return isValid;
}

function checkFormValid(){
  const repOk = repName.value.trim().length > 0;
  const emailOk = emailRegex.test(email.value.trim());
  const passOk = password.value.trim().length > 0;
  const countryOk = country.value !== '';
  const roleOk = document.querySelector('input[name="role"]:checked') !== null;
  const agreeOk = agree.checked;

  const allValid = repOk && emailOk && passOk && countryOk && roleOk && agreeOk;

  submitBtn.disabled = !allValid;
  submitBtn.classList.toggle('enabled', allValid);
}

// live email validation (error shows while typing invalid, like the reference)
email.addEventListener('input', () => {
  validateEmail(true);
  checkFormValid();
});
email.addEventListener('blur', () => {
  validateEmail(true);
});

[officialName, repName, password].forEach(el => {
  el.addEventListener('input', checkFormValid);
});
country.addEventListener('change', checkFormValid);
agree.addEventListener('change', checkFormValid);
document.querySelectorAll('input[name="role"]').forEach(r => r.addEventListener('change', checkFormValid));

const eyeOpen = document.getElementById('eyeOpen');
const eyeClosed = document.getElementById('eyeClosed');

togglePass.addEventListener('click', () => {
  const isHidden = password.type === 'password';
  password.type = isHidden ? 'text' : 'password';

  // icon swap
  eyeOpen.style.display = isHidden ? 'none' : 'block';
  eyeClosed.style.display = isHidden ? 'block' : 'none';
});

form.addEventListener('submit', (e) => {
  e.preventDefault();
  if(!submitBtn.disabled){
    alert('Account created successfully!');
  }
});
</script>

@endsection