<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    $(document).ready(function() {

        const stepIndicators = document.querySelectorAll(".stepIndicator ul li");

        const steps = {
            1: document.getElementById("step1"),
            2: document.getElementById("step2"),
            3: document.getElementById("step3")
        };

        function goToStep(stepNum) {

            Object.values(steps).forEach(step => {
                step.classList.add("d-none");
            });

            steps[stepNum].classList.remove("d-none");

            stepIndicators.forEach((li, index) => {
                li.classList.toggle("active", index < stepNum);
            });
        }

        function populateReview() {

            document.getElementById("reviewJobTitle").textContent =
                document.getElementById("jobTitle").value;

            document.getElementById("reviewCategory").textContent =
                document.getElementById("category").options[
                    document.getElementById("category").selectedIndex
                ].text;

            document.getElementById("reviewBudget").textContent =
                "₹ " + document.getElementById("budgetInput").value;

            document.getElementById("reviewDuration").textContent =
                document.getElementById("duration").options[
                    document.getElementById("duration").selectedIndex
                ].text;

            const description = $('#projectDescription').val();

            document.getElementById("reviewDescription").innerHTML =
                description.replace(/\n/g, "<br>");

            // Skills
            let skills = document.getElementById("skillsHidden").value;

            let skillHtml = "";

            skills.split(",").forEach(function(skill) {

                skill = skill.trim();

                if (skill !== "") {
                    skillHtml += `<li>${skill}</li>`;
                }

            });

            document.getElementById("reviewSkills").innerHTML = skillHtml;

            // Attachment cards come from #attachmentPreview2 via renderPreview()

        }

        const jobTitle = document.getElementById("jobTitle");
        const letterCount = document.querySelector("#step1 .lettercount");

        if (jobTitle && letterCount) {
            const updateLetterCount = () => {
                const len = jobTitle.value.length;
                letterCount.textContent = `${len}/80`;
            };

            jobTitle.addEventListener("input", updateLetterCount);
            updateLetterCount();
        }

        const budgetInput = document.getElementById("budgetInput");

        if (budgetInput) {
            budgetInput.addEventListener("input", function() {
                this.value = this.value.replace(/\D/g, "");
            });
        }

        document.getElementById("openStep2").addEventListener("click", function(e) {

            e.preventDefault();
            e.stopImmediatePropagation();

            let category = document.getElementById("category");
            let duration = document.getElementById("duration");

            if (jobTitle.value.trim() === "") {
                showError("jobTitleError", "Please enter job title.");
                jobTitle.focus();
                return;
            }

            if (category.value === "") {
                showError("categoryError", "Please select Category.");
                category.focus();
                return;
            }

            if (budgetInput.value.trim() === "") {
                showError("budgetError", "Please enter Budget.");
                budgetInput.focus();
                return;
            }

            if (parseInt(budgetInput.value) <= 0) {
                showError("budgetError", "Budget must be greater than 0.");
                budgetInput.focus();
                return;
            }

            if (duration.value === "") {
                showError("durationError", "Please select Project Duration.");
                duration.focus();
                return;
            }

            goToStep(2);
        });

        function showError(id, message) {
            $("#" + id).text(message);
        }

        function clearErrors() {
            $(".error-text").text("");
        }

        document.getElementById("openStep3").addEventListener("click", function(e) {

            e.preventDefault();

            let skills = document.getElementById("skillsHidden");

            const description = $('#projectDescription').val().trim();

            if (description === "") {
                showError("descriptionError", "Please enter Project Description.");
                return;
            }

            const plainText = $('<div>').html(description).text().trim();

            if (plainText.length < 30) {
                showError("descriptionError", "Project Description should be at least 30 characters.");
                return;
            }

            if (skills.value.trim() === "") {
                showError("skillsError", "Please add at least one skill.");
                document.getElementById("skillInput").focus();
                return;
            }

            populateReview();
            goToStep(3);

        });

        document.getElementById("backToStep1").addEventListener("click", function(e) {
            e.preventDefault();
            goToStep(1);
        });

        document.getElementById("backToStep2").addEventListener("click", function(e) {
            e.preventDefault();
            goToStep(2);
        });

        $("#jobPostForm").submit(function(e) {

            e.preventDefault();

            let formData = new FormData(document.getElementById("jobPostForm"));

            $.ajax({

                url: "{{ route('employer.jobs.store') }}",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,

                // Loader starts here
                beforeSend: function() {
                    $("#submitJobBtn").prop("disabled", true);
                    $("#btnText").hide();
                    $("#jobLoader").show();
                },

                success: function(response) {
                    // Reset the form
                    $("#jobPostForm")[0].reset();

                    // Go back to Step 1 (optional)
                    goToStep(1);

                    // Show Bootstrap modal
                    $("#successModal").modal("show");
                },

                error: function(xhr) {

                    if (xhr.status == 422) {

                        let errors = xhr.responseJSON.errors;

                        $.each(errors, function(key, value) {
                            alert(value[0]);
                            return false;
                        });

                    } else {
                        alert("Something went wrong.");
                    }

                },

                // Loader stops here
                complete: function() {
                    $("#submitJobBtn").prop("disabled", false);
                    $("#jobLoader").hide();
                    $("#btnText").show();
                }

            });

        });

        goToStep(1);
    });

    $("#aiSuggestBtn").click(function(e) {

        e.preventDefault();

        let jobTitle = $("#jobTitle").val().trim();
        let category = $("#category option:selected").text();
        let budget = $("#budgetInput").val();
        let duration = $("#duration option:selected").text();
        let description = $('#projectDescription').val().trim();

        if (jobTitle == "") {
            alert("Please complete Step 1 first.");
            return;
        }

        $.ajax({

            url: "{{ route('employer.ai.job.description') }}",
            type: "POST",

            data: {
                _token: "{{ csrf_token() }}",
                job_title: jobTitle,
                category: category,
                budget: budget,
                duration: duration,
                description: description
            },

            beforeSend: function() {

                $("#aiSuggestBtn span").text("Generating...");
                $("#aiSuggestBtn").css("pointer-events", "none");

            },

            success: function(response) {
                $("#descriptionError").text("");
                $("#projectDescription").val(response.data.project_description);

                let html = "";

                response.data.skills.forEach(function(skill) {
                    html += `<li class="ai-skill">${skill}</li>`;
                });

                $("#skillsSuggestionBox ul").html(html);

                // Show only after AI response
                $("#skillsSuggestionBox").fadeIn();
            },

            complete: function() {

                $("#aiSuggestBtn span").text("Ai Suggest");
                $("#aiSuggestBtn").css("pointer-events", "auto");

            },

            error: function() {

                alert("Unable to generate description.");

            }

        });

    });

    $("#suggestSkillsBtn").click(function(e) {

        e.preventDefault();

        let jobTitle = $("#jobTitle").val().trim();
        let category = $("#category option:selected").text();
        let budget = $("#budgetInput").val();
        let duration = $("#duration option:selected").text();
        let description = $('#projectDescription').val().trim();

        if (jobTitle == "") {
            alert("Please complete Step 1 first.");
            return;
        }

        if (description == "") {
            alert("Please enter or generate a project description first.");
            return;
        }

        $.ajax({

            url: "{{ route('employer.ai.job.skills') }}",
            type: "POST",

            data: {
                _token: "{{ csrf_token() }}",
                job_title: jobTitle,
                category: category,
                budget: budget,
                duration: duration,
                description: description
            },

            beforeSend: function() {

                $("#skillsSuggestionBox").hide();
                $("#skillsSuggestionBox ul").html("");

                $("#suggestSkillsBtn span").text("Generating...");
                $("#suggestSkillsBtn").css("pointer-events", "none");

            },

            success: function(response) {

                let html = "";

                response.skills.forEach(function(skill) {
                    html += `<li class="ai-skill">${skill}</li>`;
                });

                $("#skillsSuggestionBox ul").html(html);

                // Show only after AI response
                $("#skillsSuggestionBox").fadeIn();

            },

            complete: function() {

                $("#suggestSkillsBtn span").text("Suggest Skills");
                $("#suggestSkillsBtn").css("pointer-events", "auto");

            },

            error: function() {

                $("#skillsSuggestionBox").hide();

                alert("Unable to generate skills.");

            }

        });

    });

    $(document).on("click", ".ai-skill", function() {

        if ($(this).hasClass("selected")) {
            return;
        }

        addSkill($(this).text());

        $(this).addClass("selected");
        $("#skillsError").text("");
    });

    const MAX_SKILLS = 10;
    const skills = [];
    const skillTagsEl = document.getElementById("skillTags");
    const skillInput = document.getElementById("skillInput");
    const skillCountEl = document.getElementById("skillcount");
    const skillsHidden = document.getElementById("skillsHidden");
    const suggestSkillsBtn = document.getElementById("suggestSkillsBtn");
    const skillsSuggestion = document.querySelector(".skillsuggetion");

    function addSkill(raw) {

        const value = (raw || "").trim();

        if (!value) return false;

        if (skills.length >= MAX_SKILLS) return false;

        const exists = skills.some(
            s => s.toLowerCase() === value.toLowerCase()
        );

        if (exists) return false;

        skills.push(value);

        renderSkills();

        return true;
    }

    function updateSkillCount() {
        if (skillCountEl) skillCountEl.textContent = `${skills.length}/${MAX_SKILLS}`;
        if (skillsHidden) skillsHidden.value = skills.join(",");
        if (skillInput) {
            skillInput.disabled = skills.length >= MAX_SKILLS;
            if (skills.length >= MAX_SKILLS) skillInput.placeholder = "Maximum 10 skills reached";
            else skillInput.placeholder = "Add skills ( e.g Figma , react , node js )";
        }
    }

    function syncSuggestionSelected() {
        document.querySelectorAll(".skillsuggetion ul li").forEach(li => {
            const name = (li.textContent || "").trim().toLowerCase();
            const selected = skills.some(s => s.toLowerCase() === name);
            li.classList.toggle("selected", selected);
        });
    }

    function renderSkills() {
        if (!skillTagsEl) return;
        skillTagsEl.innerHTML = "";
        skills.forEach((skill, index) => {
            const tag = document.createElement("span");
            tag.className = "skill-tag";
            const label = document.createElement("span");
            label.textContent = skill;
            tag.appendChild(label);
            const removeBtn = document.createElement("button");
            removeBtn.type = "button";
            removeBtn.setAttribute("aria-label", "Remove skill");
            removeBtn.textContent = "×";
            removeBtn.addEventListener("click", () => {
                skills.splice(index, 1);
                renderSkills();
            });
            tag.appendChild(removeBtn);
            skillTagsEl.appendChild(tag);
        });
        updateSkillCount();
        syncSuggestionSelected();
    }

    function processSkillInput(value) {
        const parts = value.split(",");
        parts.forEach(part => addSkill(part));
        if (skillInput) skillInput.value = "";
    }

    if (skillInput) {
        skillInput.addEventListener("keydown", e => {
            if (e.key === "Enter") {
                e.preventDefault();
                processSkillInput(skillInput.value);
            } else if (e.key === ",") {
                e.preventDefault();
                processSkillInput(skillInput.value);
            } else if (e.key === "Backspace" && !skillInput.value && skills.length) {
                skills.pop();
                renderSkills();
            }
        });

        skillInput.addEventListener("input", () => {
            if (skillInput.value.includes(",")) {
                processSkillInput(skillInput.value);
            }
        });
    }

    document.querySelectorAll(".skillsuggetion ul li").forEach(li => {
        li.addEventListener("click", () => {
            addSkill(li.textContent);
        });
    });

    if (suggestSkillsBtn && skillsSuggestion) {
        suggestSkillsBtn.addEventListener("click", e => {
            e.preventDefault();
            skillsSuggestion.scrollIntoView({
                behavior: "smooth",
                block: "nearest"
            });
        });
    }

    updateSkillCount();

    $("#jobTitle").on("input", function() {
        $("#jobTitleError").text("");
    });

    $("#category").on("change", function() {
        $("#categoryError").text("");
    });

    $("#budgetInput").on("input", function() {
        $("#budgetError").text("");
    });

    $("#duration").on("change", function() {
        $("#durationError").text("");
    });

    $("#projectDescription").on("input", function() {
        $("#descriptionError").text("");
    });

    $("#skillInput").on("input", function() {
        $("#skillsError").text("");
    });

    /* Attachment upload preview (frontend only) */
    (function() {
        var ALLOWED = ["pdf", "doc", "docx", "png", "jpg", "jpeg"];
        var MAX_BYTES = 25 * 1024 * 1024;
        var pendingFiles = [];
        var dropzone = document.getElementById("attachmentDropzone");
        var fileInput = document.getElementById("attachmentInput");
        var preview = document.getElementById("attachmentPreview");
        var preview2 = document.getElementById("attachmentPreview2");

        if (!dropzone || !fileInput || !preview || !preview2) return;

        var removeIconSvg =
            '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">' +
            '<path d="M4.5 4.5L11.5 11.5M11.5 4.5L4.5 11.5" stroke="#E53935" stroke-width="1.5" stroke-linecap="round"/>' +
            "</svg>";

        function getExt(name) {
            var parts = String(name || "").toLowerCase().split(".");
            return parts.length > 1 ? parts.pop() : "";
        }

        function isAllowed(file) {
            return ALLOWED.indexOf(getExt(file.name)) !== -1 && file.size <= MAX_BYTES;
        }

        function formatFileSize(bytes) {
            if (bytes < 1024) return bytes + "b";
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1).replace(/\.0$/, "") + "kb";
            return (bytes / (1024 * 1024)).toFixed(1).replace(/\.0$/, "") + "mb";
        }

        function getFileIconSvg(ext) {
            if (ext === "pdf") {
                return (
                    '<svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30" fill="none">' +
                    '<rect width="30" height="30" rx="7" fill="#FDECEC"/>' +
                    '<path d="M9 7.5H16.5L21 12V22.5H9V7.5Z" fill="#E53935"/>' +
                    '<path d="M16.5 7.5V12H21" fill="#FF8A80"/>' +
                    '<text x="15" y="20" text-anchor="middle" fill="#fff" font-size="6" font-family="Inter,Arial" font-weight="700">PDF</text>' +
                    "</svg>"
                );
            }
            if (ext === "docx" || ext === "doc") {
                return (
                    '<svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30" fill="none">' +
                    '<rect width="30" height="30" rx="7" fill="#E8F1FB"/>' +
                    '<path d="M9 7.5H16.5L21 12V22.5H9V7.5Z" fill="#2B579A"/>' +
                    '<path d="M16.5 7.5V12H21" fill="#7BA3D4"/>' +
                    '<text x="15" y="20" text-anchor="middle" fill="#fff" font-size="5.5" font-family="Inter,Arial" font-weight="700">DOC</text>' +
                    "</svg>"
                );
            }
            return (
                '<svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30" fill="none">' +
                '<rect width="30" height="30" rx="7" fill="#E8F8EE"/>' +
                '<path d="M8.5 20.5L12.2 15.8L15.1 19.1L19.2 13.5L21.5 20.5H8.5Z" fill="#00A148"/>' +
                '<circle cx="12" cy="11" r="1.6" fill="#00A148"/>' +
                '<rect x="8" y="8" width="14" height="14" rx="2" stroke="#00A148" stroke-width="1.5" fill="none"/>' +
                "</svg>"
            );
        }

        function syncInputFiles() {
            var dt = new DataTransfer();
            pendingFiles.forEach(function(file) {
                dt.items.add(file);
            });
            fileInput.files = dt.files;
        }

        function renderPreview() {
            preview.innerHTML = "";
            preview2.innerHTML = "";
            preview.classList.remove("has-files");
            preview2.classList.remove("has-files");
            preview2.classList.remove("is-empty");

            if (!pendingFiles.length) {
                preview2.classList.add("is-empty");
                preview2.textContent = "No attachment";
                return;
            }

            preview.classList.add("has-files");
            preview2.classList.add("has-files");
            pendingFiles.forEach(function(file, index) {
                var ext = getExt(file.name);
                var body =
                    '<div class="icon">' + getFileIconSvg(ext) + "</div>" +
                    '<div class="text"><h2></h2><p></p></div>';

                var card = document.createElement("div");
                card.className = "uploaded-file";
                card.innerHTML = body +
                    '<a href="#" class="remove-file" data-index="' + index + '" title="Remove file">' + removeIconSvg + "</a>";
                card.querySelector("h2").textContent = file.name;
                card.querySelector("p").textContent = formatFileSize(file.size);
                preview.appendChild(card);

                var card2 = document.createElement("div");
                card2.className = "uploaded-file";
                card2.innerHTML = body;
                card2.querySelector("h2").textContent = file.name;
                card2.querySelector("p").textContent = formatFileSize(file.size);
                preview2.appendChild(card2);
            });
        }

        function addFiles(fileList) {
            Array.prototype.forEach.call(fileList, function(file) {
                if (!isAllowed(file)) return;
                var exists = pendingFiles.some(function(f) {
                    return f.name === file.name && f.size === file.size && f.lastModified === file.lastModified;
                });
                if (!exists) pendingFiles.push(file);
            });
            syncInputFiles();
            renderPreview();
        }

        fileInput.addEventListener("change", function() {
            if (fileInput.files && fileInput.files.length) {
                addFiles(fileInput.files);
            }
        });

        ["dragenter", "dragover"].forEach(function(evt) {
            dropzone.addEventListener(evt, function(e) {
                e.preventDefault();
                e.stopPropagation();
                dropzone.classList.add("is-dragover");
            });
        });

        ["dragleave", "drop"].forEach(function(evt) {
            dropzone.addEventListener(evt, function(e) {
                e.preventDefault();
                e.stopPropagation();
                dropzone.classList.remove("is-dragover");
            });
        });

        dropzone.addEventListener("drop", function(e) {
            var files = e.dataTransfer && e.dataTransfer.files;
            if (files && files.length) addFiles(files);
        });

        preview.addEventListener("click", function(e) {
            var btn = e.target.closest(".remove-file");
            if (!btn) return;
            e.preventDefault();
            var index = parseInt(btn.getAttribute("data-index"), 10);
            if (!isNaN(index)) {
                pendingFiles.splice(index, 1);
                syncInputFiles();
                renderPreview();
            }
        });

        renderPreview();
    })();
</script>
<script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>

<script>
    const textarea = document.getElementById('projectDescription');
    const textareaFooter = document.querySelector('.textareafooter');

    textarea.addEventListener('input', function () {

        const words = this.value
            .trim()
            .split(/\s+/)
            .filter(word => word.length > 0);

        if (words.length >= 100) {
            textareaFooter.style.display = 'flex'; // or 'block' depending on your CSS
        } else {
            textareaFooter.style.display = 'none';
        }

    });

    // let editor;

    // ClassicEditor
    //     .create(document.querySelector('#projectDescription'))
